generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ---- NextAuth Boilerplate ----

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For simple credentials auth
  accounts      Account[]
  sessions      Session[]
  chatSessions  ChatSession[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- ClarityAI Application Data ----

model ChatSession {
  id             String    @id
  title          String
  phase          String
  questionCount  Int       @default(0)
  totalQuestions Int       @default(5)
  category       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  messages       Message[]
}

model Message {
  id            String      @id
  role          String
  content       String      
  isReport      Boolean     @default(false)
  choicesJson   String?     // Stored as JSON string
  timestamp     Float
  
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
}
